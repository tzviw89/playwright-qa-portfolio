{
  "name": "playwright-qa-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playwright UI and API tests against public practice sites.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:saucedemo": "playwright test --project=saucedemo",
    "test:the-internet": "playwright test --project=the-internet",
    "test:restful-booker": "playwright test --project=restful-booker",
    "test:demoqa": "playwright test --project=demoqa",
    "test:uitestingplayground": "playwright test --project=uitestingplayground",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "triage": "node triage/src/cli.ts",
    "test:triage": "node --test --test-concurrency=1 triage/tests/triage.test.ts"
  },
  "devDependencies": {
    "@langchain/core": "^1.3.5",
    "@langchain/langgraph": "^1.7.2",
    "@langchain/openai": "^1.8.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
